# =============================================================================
# Git LFS Configuration
# =============================================================================
# For this Yocto project, LFS is NOT required if you follow the .gitignore
# correctly (build artifacts are excluded).
#
# However if you ever need to store pre-built images or large binaries,
# uncomment the lines below.
# =============================================================================

# Large binary/image files (uncomment if needed)
# *.ext4 filter=lfs diff=lfs merge=lfs -text
# *.wic filter=lfs diff=lfs merge=lfs -text
# *.bin filter=lfs diff=lfs merge=lfs -text
# *.img filter=lfs diff=lfs merge=lfs -text
# *.tar.bz2 filter=lfs diff=lfs merge=lfs -text
# *.tar.gz filter=lfs diff=lfs merge=lfs -text

# Kernel images (uncomment if needed)
# Image filter=lfs diff=lfs merge=lfs -text
# uImage filter=lfs diff=lfs merge=lfs -text
# zImage filter=lfs diff=lfs merge=lfs -text

# Text files - always use LF line endings
*.bb text eol=lf
*.bbappend text eol=lf
*.bbclass text eol=lf
*.inc text eol=lf
*.conf text eol=lf
*.cfg text eol=lf
*.scc text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
Makefile text eol=lf
